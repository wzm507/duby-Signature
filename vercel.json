{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    },
    {
      "src": "api/**/*.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1",
      "headers": {
        "Access-Control-Allow-Origin": "*",
        "Access-Control-Allow-Headers": "Content-Type",
        "Access-Control-Allow-Methods": "POST, OPTIONS"
      }
    },
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/img/(.*)",
      "dest": "/img/$1"
    },
    {
      "src": "/off/(.*)",
      "dest": "/off/$1"
    },
    {
      "src": "/Developers/(.*)",
      "dest": "/Developers/$1"
    },
    {
      "src": "/Communities/(.*)",
      "dest": "/Communities/$1"
    },
    {
      "src": "/aboutus/(.*)",
      "dest": "/aboutus/$1"
    },
    {
      "src": "/banner/(.*)",
      "dest": "/banner/$1"
    },
    {
      "src": "/ewm/(.*)",
      "dest": "/ewm/$1"
    },
    {
      "src": "/icons/(.*)",
      "dest": "/icons/$1"
    },
    {
      "src": "/images_new/(.*)",
      "dest": "/images_new/$1"
    },
    {
      "src": "/Terra Gardens/(.*)",
      "dest": "/Terra Gardens/$1"
    },
    {
      "src": "/Lyvia by Palace/(.*)",
      "dest": "/Lyvia by Palace/$1"
    },
    {
      "src": "/DAMAC Islands/(.*)",
      "dest": "/DAMAC Islands/$1"
    },
    {
      "src": "/Greenridge/(.*)",
      "dest": "/Greenridge/$1"
    },
    {
      "src": "/Services/(.*)",
      "dest": "/Services/$1"
    },
    {
      "src": "/sp/(.*)",
      "dest": "/sp/$1"
    },
    {
      "src": "/js/(.*)",
      "dest": "/js/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ],
  "env": {
    "SMTP_HOST": "smtp.163.com",
    "SMTP_PORT": "465",
    "SMTP_USER": "wzm2383983461@163.com",
    "SMTP_PASS": "${SMTP_PASS}"
  }
}